# Copy to .env and fill in. Never commit .env.

# --- SEC EDGAR (required) ---
# Declared User-Agent: "Your Name your@email.com". Requests without it get HTTP 403.
EDGAR_IDENTITY=
# Stay safely under SEC's 10 requests/second limit.
EDGAR_MAX_RPS=8

# --- Data ---
DATA_DIR=./data
UNIVERSE_FILE=./config/pilot_universe.csv
START_YEAR=2015
FORMS=10-K,10-Q

# --- Chunking (specs/02; evals in specs/05 pick final values) ---
# Defaults leave headroom under bge-small's 512-token limit.
CHUNK_MAX_TOKENS=448
CHUNK_OVERLAP_TOKENS=48
CHUNK_MIN_TOKENS=64
CHUNK_STRATEGY=structure

# --- Database (matches docker-compose; host port 5433 avoids a local Postgres on 5432) ---
DATABASE_URL=postgresql://filinglens:filinglens@localhost:5433/filinglens

# --- LLM ---
# auto = Claude if ANTHROPIC_API_KEY is set, else a local Ollama model if running, else
# no LLM (extractive answers + rule-based tool routing; free). Or force: anthropic|ollama|none
LLM_PROVIDER=auto
# Local model (free): `brew install ollama && ollama pull qwen2.5:3b` (~2 GB; fits 8 GB RAM)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# Thinking depth for answers: low | medium | high | xhigh | max
LLM_EFFORT=medium
# Max model requests per agent question (specs/04)
AGENT_MAX_STEPS=6
# Daily spend cap in USD for the public demo.
LLM_DAILY_SPEND_CAP_USD=5

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- Retrieval (specs/03; evals in specs/05 pick final values) ---
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATE_K=40
USE_HYBRID=true
RRF_K=60
USE_RERANK=false
RERANK_TOP_N=8
RERANK_MODEL=BAAI/bge-reranker-base

# --- API ---
API_CORS_ORIGINS=http://localhost:8501,http://localhost:5173
