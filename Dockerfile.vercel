# syntax=docker/dockerfile:1
# FilingLens API as a Vercel Function (container image). Same build as ./Dockerfile, plus:
# - the parsed filing sections are baked in from the published seed bundle (the API reads
#   them from disk for year-over-year diffs; the database tables live in Neon),
# - it listens on $PORT (set PORT=8000 in the Vercel project), with no entrypoint seeding.
FROM python:3.12-slim AS builder
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_HTTP_TIMEOUT=300 UV_HTTP_RETRIES=10
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project
COPY src ./src
RUN uv sync --frozen --no-dev
ENV FASTEMBED_CACHE_PATH=/app/models
RUN /app/.venv/bin/python -c "from fastembed import TextEmbedding; TextEmbedding('BAAI/bge-small-en-v1.5', cache_dir='/app/models')"
# Section files only (no database needed at build time).
ARG SEED_URL=https://github.com/haybraham360/Filinglens/releases/download/seed-v1/seed.tar.gz
RUN DATA_DIR=/app/data /app/.venv/bin/filinglens seed-import --files-only --url "$SEED_URL"

FROM python:3.12-slim
RUN useradd --create-home --uid 1000 app
WORKDIR /app
COPY --from=builder --chown=app:app /app /app
COPY --chown=app:app config ./config
ENV PATH="/app/.venv/bin:$PATH" PYTHONUNBUFFERED=1 FASTEMBED_CACHE_PATH=/app/models \
    DATA_DIR=/app/data HF_HUB_OFFLINE=1 PORT=8000
USER app
EXPOSE 8000
CMD ["sh", "-c", "exec uvicorn filinglens.api.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1 --proxy-headers --forwarded-allow-ips='*'"]
